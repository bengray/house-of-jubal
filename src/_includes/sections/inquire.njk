<section class="inquire light" id="inquire">
  <div class="wrap inquire__inner">
    <div class="inquire__intro stack-m">
      <p class="eyebrow eyebrow--walnut">VII. Start here</p>
      <h2 class="h2">Tell me about the guitar <em>in your head.</em></h2>
      <p>Commission, Redemption, a pair of covers or just a setup — every message gets a personal reply, usually within {{ site.replyTime }}. Pricing depends on the build, so it's shared once we've talked.</p>
      <p class="mono-note">Or write directly: <a href="mailto:{{ site.email }}">{{ site.email }}</a></p>
    </div>
    {% include "partials/inquiry-form.njk" %}
  </div>
</section>
